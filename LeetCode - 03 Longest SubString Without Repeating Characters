class Solution {
    public int lengthOfLongestSubstring(String s) {
        int lastSeen[] = new int[256];
        int left = 0 ;
        int count = 0;
        for(int right=0; right < s.length(); right++) {
            char c = s.charAt(right);
            if(lastSeen[c] > left) {
                left = lastSeen[c];
            }
            lastSeen[c] = right + 1;
            count = Math.max(count, right-left+1);
        }
        return count;
    }
}
